{
  "extends": ["html-validate:recommended"],
  "rules": {
    "void-style": "off",
    "no-inline-style": "off",
    "attribute-boolean-style": "off",
    "require-sri": "off",
    "long-title": "off",
    "wcag/h63": "off",
    "no-trailing-whitespace": "off",
    "prefer-native-element": "error",
    "element-required-attributes": "error",
    "no-dup-id": "error",
    "heading-level": "error",
    "input-missing-label": "error",
    "unique-landmark": "error"
  },
  "elements": ["html5"]
}
